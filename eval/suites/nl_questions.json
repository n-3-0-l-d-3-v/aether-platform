{
  "name": "nl_questions",
  "kind": "questions",
  "description": "Labelled corpus for the narrow question interface. Measures whether a question is routed to the right type, and - the error that matters most - whether an unsupported question is answered anyway. Fifty in-scope phrasings across the five supported types, and twenty out-of-scope questions a product-security engineer might plausibly ask but Phase 1 does not answer. Note the obvious limitation: the vocabulary and this corpus were written by the same author, so these numbers measure internal consistency, not performance against phrasings nobody anticipated.",
  "thresholds": {
    "min_accuracy": 0.9,
    "min_macro_precision": 0.9,
    "max_false_accepts": 0
  },
  "cases": [
    { "question": "Are there any hardcoded secrets?", "expect": "hardcoded_secrets" },
    { "question": "any passwords in this thing", "expect": "hardcoded_secrets" },
    { "question": "does it contain an api key", "expect": "hardcoded_secrets" },
    { "question": "find hardcoded credentials", "expect": "hardcoded_secrets" },
    { "question": "is there a private key embedded in the firmware", "expect": "hardcoded_secrets" },
    { "question": "show me any access keys", "expect": "hardcoded_secrets" },
    { "question": "are credentials baked into the binary?", "expect": "hardcoded_secrets" },
    { "question": "any auth tokens?", "expect": "hardcoded_secrets" },
    { "question": "does this leak a secret", "expect": "hardcoded_secrets" },
    { "question": "hardcoded password check", "expect": "hardcoded_secrets" },

    { "question": "What third-party components are in this image?", "expect": "embedded_components" },
    { "question": "give me an sbom", "expect": "embedded_components" },
    { "question": "which libraries does it embed", "expect": "embedded_components" },
    { "question": "what openssl version is in here", "expect": "embedded_components" },
    { "question": "list the dependencies", "expect": "embedded_components" },
    { "question": "what open source components does it use", "expect": "embedded_components" },
    { "question": "is busybox in this firmware", "expect": "embedded_components" },
    { "question": "bill of materials please", "expect": "embedded_components" },
    { "question": "which third party software is bundled", "expect": "embedded_components" },
    { "question": "what library versions are embedded", "expect": "embedded_components" },

    { "question": "What is the attack surface?", "expect": "attack_surface" },
    { "question": "does it call any dangerous functions", "expect": "attack_surface" },
    { "question": "any risky api usage", "expect": "attack_surface" },
    { "question": "where could this be attacked?", "expect": "attack_surface" },
    { "question": "does it use strcpy", "expect": "attack_surface" },
    { "question": "is this exploitable", "expect": "attack_surface" },
    { "question": "show me unsafe functions", "expect": "attack_surface" },
    { "question": "any command injection surface", "expect": "attack_surface" },
    { "question": "buffer overflow risk", "expect": "attack_surface" },
    { "question": "what can an attacker reach", "expect": "attack_surface" },

    { "question": "Any suspicious strings?", "expect": "suspicious_indicators" },
    { "question": "what urls does it contain", "expect": "suspicious_indicators" },
    { "question": "does it phone home", "expect": "suspicious_indicators" },
    { "question": "any hardcoded ip addresses", "expect": "suspicious_indicators" },
    { "question": "show me network indicators", "expect": "suspicious_indicators" },
    { "question": "what endpoints does it talk to", "expect": "suspicious_indicators" },
    { "question": "any suspicious behaviour", "expect": "suspicious_indicators" },
    { "question": "does it run shell commands", "expect": "suspicious_indicators" },
    { "question": "list the domains in the binary", "expect": "suspicious_indicators" },
    { "question": "any beacon addresses", "expect": "suspicious_indicators" },

    { "question": "Is this binary hardened?", "expect": "binary_hardening" },
    { "question": "are NX and RELRO enabled", "expect": "binary_hardening" },
    { "question": "what mitigations does it have", "expect": "binary_hardening" },
    { "question": "is pie enabled", "expect": "binary_hardening" },
    { "question": "does it have a stack canary", "expect": "binary_hardening" },
    { "question": "check the exploit mitigations", "expect": "binary_hardening" },
    { "question": "was it compiled with fortify", "expect": "binary_hardening" },
    { "question": "aslr status", "expect": "binary_hardening" },
    { "question": "what protections are enabled", "expect": "binary_hardening" },
    { "question": "hardening report", "expect": "binary_hardening" },

    { "question": "what is the weather today", "expect": null },
    { "question": "write me a poem about binaries", "expect": null },
    { "question": "what CVEs affect this firmware", "expect": null },
    { "question": "show me the call graph", "expect": null },
    { "question": "decompile the main function", "expect": null },
    { "question": "what does this function do", "expect": null },
    { "question": "is this malware", "expect": null },
    { "question": "who wrote this firmware", "expect": null },
    { "question": "when was this compiled", "expect": null },
    { "question": "how big is the binary", "expect": null },
    { "question": "rename this variable for me", "expect": null },
    { "question": "patch the binary to skip the check", "expect": null },
    { "question": "emulate this firmware", "expect": null },
    { "question": "diff this against the previous version", "expect": null },
    { "question": "what architecture is this", "expect": null },
    { "question": "generate an exploit", "expect": null },
    { "question": "summarise everything you know", "expect": null },
    { "question": "monkey business", "expect": null },
    { "question": "a piece of cake", "expect": null },
    { "question": "hello there", "expect": null }
  ]
}
